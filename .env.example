# SilentSOS local config — copy to .env (NEVER commit .env)
# Backend
SILENT_DB_PATH=./data/silentsos.db
PORT=8001
# Public base URL used for tracking links in Telegram messages.
# Local default is http://127.0.0.1:8001. In production set this to your
# public https:// URL (e.g. https://silentsos.onrender.com).
PUBLIC_BASE_URL=http://127.0.0.1:8001
# Telegram notifications (optional — alerts work fine without it)
# Get a token from @BotFather, then:
TELEGRAM_BOT_TOKEN=
# Automatic escalation: seconds after an alert with no acknowledgement
# before tier-2 contacts are notified and the alert is marked ESCALATED.
ESCALATION_SECONDS=60
# Simulated device credentials (fill in after seeding):
# SILENT_DEVICE_ID=dev-001
# SILENT_DEVICE_KEY=<base64 key printed by: python scripts/seed_demo.py>
